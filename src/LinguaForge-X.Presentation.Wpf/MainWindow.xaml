<Window x:Class="LinguaForge_X.Presentation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LinguaForge_X.Presentation.Wpf"
        mc:Ignorable="d"
        Title="LinguaForge-X" Height="220" Width="540" WindowStartupLocation="CenterScreen">
    <Grid>
        <Border Margin="24" Padding="20" BorderThickness="1" CornerRadius="8" BorderBrush="#D6D6D6">
            <StackPanel>
                <TextBlock Text="WPF + .NET 10 + Clean Architecture"
                           FontWeight="SemiBold"
                           FontSize="20"
                           Margin="0,0,0,12" />
                <TextBlock x:Name="GreetingText" FontSize="14" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
