<Window x:Class="LinguaForge_X.Presentation.Wpf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:LinguaForge_X.Presentation.Wpf.Controls"
 Title="LinguaForge-X · 视频字幕与配音" Height="900" Width="1360" MinHeight="720" MinWidth="1120"
 WindowStartupLocation="CenterScreen" Background="#F4F6FA" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
 Loaded="Window_Loaded" Closing="Window_Closing">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#243149"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Foreground" Value="#55627A"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="17"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E1E6EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="20"/></Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="15,9"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#34435E"/><Setter Property="BorderBrush" Value="#CED6E3"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#3559D8"/><Setter Property="BorderBrush" Value="#3559D8"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#D1D9E5"/><Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#D1D9E5"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,5,18,5"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="24,13"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E8EDF4"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F7F9FD"/><Setter Property="BorderBrush" Value="#DFE5EF"/><Setter Property="ColumnHeaderHeight" Value="36"/><Setter Property="RowHeight" Value="68"/></Style>
  <Style x:Key="GridText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="8,6"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="GridEditor" TargetType="TextBox"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="AcceptsReturn" Value="True"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style>
  <Style x:Key="HistoryText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="6,0"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
 </Window.Resources>
 <Grid Background="#F4F6FA">
  <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <MediaElement x:Name="VoicePlayer" LoadedBehavior="Manual" UnloadedBehavior="Close" Visibility="Collapsed"/><Border Background="#18253E" Padding="30,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LinguaForge-X" Foreground="White" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="让视频素材，跨越语言边界" Foreground="#B3C4E5" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="Azure 语音与翻译  /  本地视频合成" Foreground="#C7D3EA" VerticalAlignment="Center"/></Grid></Border>
  <TabControl Grid.Row="1" Margin="22,18,22,12" SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0">
   <TabItem Header="视频转换">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,18,0,0"><StackPanel>
     <Border x:Name="OnlineVideoCard" Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
      <DockPanel Margin="0,0,0,12"><TextBlock DockPanel.Dock="Right" Text="B 站 · YouTube · 更多网站" Foreground="#718096" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="在线视频素材" Style="{StaticResource SectionTitle}" Margin="0"/></DockPanel>
      <Grid IsEnabled="{Binding CanConfigure}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition Width="148"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox Text="{Binding OnlineUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="粘贴单个视频的 HTTPS 链接" MinWidth="240"/>
       <ComboBox Grid.Column="2" ItemsSource="{Binding DownloadQualities}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding DownloadMaxHeight}" ToolTip="选择下载画质上限"/>
       <Button Grid.Column="3" Content="读取信息" Command="{Binding InspectOnlineCommand}" Margin="10,0,0,0"/>
       <Button Grid.Column="4" Content="下载并导入" Command="{Binding DownloadOnlineCommand}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/>
      </Grid>
      <TextBlock Text="{Binding OnlineSummary}" TextWrapping="Wrap" Foreground="#55627A" Margin="0,10,0,0"/>
      <WrapPanel Margin="0,12,0,0"><Button Content="网页登录／验证" Command="{Binding OpenVerificationCommand}" Margin="0,0,10,8"/><Button Content="使用会话并重试" Command="{Binding UseVerificationCommand}" Margin="0,0,10,8"/><Button Content="关闭验证窗口" Command="{Binding CloseVerificationCommand}" Margin="0,0,10,8"/><Button Content="清除该站会话" Command="{Binding ClearWebsiteSessionCommand}" Margin="0,0,0,8"/></WrapPanel>
      <TextBlock Text="{Binding VerificationSummary}" TextWrapping="Wrap" Foreground="#385389"/>
      <TextBlock Text="验证会打开独立浏览器窗口，可能需要重新登录。请亲自在网站完成验证；点击使用后仅保存该站会话并关闭该窗口。也可在服务设置中选择 Cookie 文件。" TextWrapping="Wrap" FontSize="11" Foreground="#718096" Margin="0,6,0,0"/>
     </StackPanel></Border>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel>
       <DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="导入本地视频" Command="{Binding ImportCommand}"/><TextBlock Text="01  视频与语言" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/></DockPanel>
       <TextBlock Text="{Binding VideoSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,7"/>
       <TextBlock Text="{Binding Options.InputPath}" TextWrapping="Wrap" Foreground="#718096" FontSize="11" Margin="0,0,0,12"/>
       <TextBlock Text="{Binding SourceSummary}" TextWrapping="Wrap" Foreground="#718096" FontSize="11" Margin="0,0,0,8"/>
       <StackPanel IsEnabled="{Binding CanConfigure}">
        <TextBlock Text="音轨" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding AudioTracks}" SelectedValuePath="StreamIndex" SelectedValue="{Binding AudioStreamIndex}" Margin="0,0,0,12"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="原音语言" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding SourceLanguages}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding SourceLanguage}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="字幕语言" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding SubtitleLanguages}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding SubtitleLanguage}"/></StackPanel></Grid>
        <WrapPanel Margin="0,10,0,8"><CheckBox Content="添加字幕" IsChecked="{Binding Options.GenerateSubtitles}"/><CheckBox Content="生成配音" IsChecked="{Binding Options.GenerateSpeech}"/></WrapPanel>
       </StackPanel>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel IsEnabled="{Binding CanConfigure}"><TextBlock Text="配音语言" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding SpeechLanguages}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding SpeechLanguage}"/></StackPanel><StackPanel Grid.Column="2" IsEnabled="{Binding IsIdle}"><TextBlock Text="配音音色" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="VoiceSelector" ItemsSource="{Binding Voices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding VoiceId}" ToolTip="可直接更换音色重新配音；本人音色请在「我的声音」添加"/></StackPanel></Grid>
       <Button Content="试听所选音色" Command="{Binding PreviewVoiceCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/><TextBlock Text="识别和翻译使用已配置的服务。选择本地 GPT-SoVITS 时配音在本机生成；云端配音按所选服务计费。视频画面在本地合成。" TextWrapping="Wrap" FontSize="11" Foreground="#718096" Margin="0,14,0,0"/>
      </StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="视频预览" Style="{StaticResource SectionTitle}"/>
       <Border Grid.Row="1" Background="#101A2B" CornerRadius="6" MinHeight="210" ClipToBounds="True"><Grid><TextBlock Text="导入视频后可在此预览" Foreground="#8093B1" HorizontalAlignment="Center" VerticalAlignment="Center"/><MediaElement x:Name="VideoPlayer" Source="{Binding PreviewPath}" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" MediaOpened="VideoPlayer_MediaOpened" MediaFailed="VideoPlayer_MediaFailed"/></Grid></Border>
       <DockPanel Grid.Row="2" Margin="0,12,0,0"><StackPanel Orientation="Horizontal"><Button Content="播放" Click="Play_Click" Padding="14,7"/><Button Content="暂停" Click="Pause_Click" Padding="14,7" Margin="8,0,0,0"/><Button Content="停止" Click="Stop_Click" Padding="14,7" Margin="8,0,0,0"/></StackPanel><TextBlock Text="导出后显示结果" FontSize="11" Foreground="#718096" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
      </Grid></Border>
     </Grid>
     <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="02  输出选项" Style="{StaticResource SectionTitle}"/>
      <Grid IsEnabled="{Binding CanConfigure}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="字幕样式" Style="{StaticResource FieldLabel}"/><WrapPanel><CheckBox Content="烧录到视频画面" IsChecked="{Binding Options.BurnSubtitles}"/><CheckBox Content="导出独立 SRT" IsChecked="{Binding Options.ExportSrt}"/><CheckBox Content="双语字幕" IsChecked="{Binding Options.BilingualSubtitles}"/></WrapPanel><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><TextBlock Text="字幕字号" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox Width="64" Text="{Binding Options.SubtitleFontSize, ValidatesOnExceptions=True}"/><TextBlock Text="像素（按视频高度缩放）" FontSize="11" Foreground="#718096" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="配音时原音轨处理" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding AudioModes}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Options.OriginalAudio}"/><TextBlock Text="本版不做人声分离。完全替换会移除原背景音乐；混合模式仍保留原人声。" TextWrapping="Wrap" FontSize="11" Foreground="#8B6526" Margin="0,8,0,0"/></StackPanel>
      </Grid>
      <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="导出编码" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="VideoEncodingSelector" ItemsSource="{Binding VideoEncodingModes}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Settings.Media.VideoEncoding, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" ToolTip="当前选择直接用于导出；在服务设置中保存后，下次打开也会沿用。恢复历史任务不会改变此设置。"/><TextBlock Text="自动检测可用显卡；无显卡时使用 CPU 快速编码。快速模式的文件可能更大。" TextWrapping="Wrap" FontSize="11" Foreground="#718096" Margin="0,8,0,0"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="输出画质" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="OutputQualitySelector" ItemsSource="{Binding OutputQualities}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Settings.Media.OutputQuality, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" ToolTip="当前选择直接用于导出；在服务设置中保存后可供下次使用。选择分辨率档位会重新编码；保持源分辨率时，未烧录字幕且格式兼容的视频可直接复制视频流。"/><TextBlock Text="按源视频上限输出，保持比例且不放大；较低档位通常更省空间，转码负担也更低。" TextWrapping="Wrap" FontSize="11" Foreground="#718096" Margin="0,8,0,0"/></StackPanel>
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,14,0,0" IsEnabled="{Binding IsIdle}"><TextBlock Text="最大配音加速" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox Width="70" Text="{Binding Options.MaxSpeechSpeed, ValidatesOnExceptions=True}"/><TextBlock Text="1.0–2.0 倍；超过此上限时可自动精简文字" FontSize="11" Foreground="#718096" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
      <CheckBox x:Name="AutoShortenSpeechToggle" Content="自动精简超时字幕／配音稿" IsChecked="{Binding Options.AutoShortenSpeech, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" Margin="0,10,0,5"/>
      <TextBlock Text="仅处理超时片段，需要已配置文本翻译服务；精简后重新配音并检查时长，最多尝试 3 次。同稿字幕同步更新，单独编辑的字幕保留。" TextWrapping="Wrap" FontSize="11" Foreground="#718096"/>
      <TextBlock Text="导出位置（MP4）" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/><DockPanel><Button DockPanel.Dock="Right" Content="选择位置" Command="{Binding ChooseOutputCommand}" Margin="10,0,0,0"/><TextBox Text="{Binding Options.OutputPath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}"/></DockPanel>
      <DockPanel Margin="0,16,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="重新设置" Command="{Binding ResetCommand}" Margin="0,0,10,0"/><Button Content="生成字幕与配音稿" Command="{Binding PrepareCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel><TextBlock Text="先生成 → 校对文本 → 合成导出" Foreground="#718096" VerticalAlignment="Center"/></DockPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="03  校对与导出" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding ProjectSummary}" TextWrapping="Wrap" Foreground="#718096" Margin="0,0,0,12"/>
      <DataGrid x:Name="SegmentsGrid" ItemsSource="{Binding Segments}" Height="290" IsEnabled="{Binding IsIdle}" BeginningEdit="SegmentsGrid_BeginningEdit"><DataGrid.Columns>
       <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="42" IsReadOnly="True"/><DataGridTextColumn Header="开始（秒）" Binding="{Binding StartSeconds, StringFormat=F2, ValidatesOnExceptions=True}" Width="88"/><DataGridTextColumn Header="结束（秒）" Binding="{Binding EndSeconds, StringFormat=F2, ValidatesOnExceptions=True}" Width="88"/>
       <DataGridTextColumn Header="原文" Binding="{Binding SourceText}" Width="*" ElementStyle="{StaticResource GridText}" EditingElementStyle="{StaticResource GridEditor}"/><DataGridTextColumn Header="字幕文本" Binding="{Binding SubtitleText}" Width="*" ElementStyle="{StaticResource GridText}" EditingElementStyle="{StaticResource GridEditor}"/><DataGridTextColumn Header="配音稿" Binding="{Binding SpeechText}" Width="*" ElementStyle="{StaticResource GridText}" EditingElementStyle="{StaticResource GridEditor}"/>
      </DataGrid.Columns></DataGrid>
      <TextBlock Text="双击单元格编辑；时间单位为秒。修改配音稿后，导出时会重新合成受影响的片段。自动精简后的文字会回填到此表格，请复核内容。" TextWrapping="Wrap" Foreground="#718096" FontSize="11" Margin="0,9,0,0"/>
      <WrapPanel HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="保存校对" Command="{Binding SaveEditsCommand}" PreviewMouseLeftButtonDown="CommitEdits" Margin="0,0,10,0"/><Button Content="打开输出文件夹" Command="{Binding OpenOutputFolderCommand}" Margin="0,0,10,0"/><Button Content="外部播放结果" Command="{Binding PlayResultCommand}" Margin="0,0,10,0"/><Button Content="合成并导出视频" Command="{Binding ExportCommand}" PreviewMouseLeftButtonDown="CommitEdits" Style="{StaticResource PrimaryButton}"/></WrapPanel>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="服务设置"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,18,0,0"><StackPanel IsEnabled="{Binding IsIdle}">
    <Border Background="#EAF0FF" CornerRadius="8" Padding="16" Margin="0,0,0,16"><TextBlock Text="分别配置转写、翻译和配音。Azure OpenAI 需要资源地址、Access Key 和部署名称；Azure AI Speech 需要对应区域的资源。英文配中文音需要翻译服务。连接测试会发送少量真实请求，可能产生少量费用。显示的是上次测试结果；修改配置后需重新测试。" TextWrapping="Wrap" Foreground="#385389"/></Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="语音转文字" Style="{StaticResource SectionTitle}"/><TextBlock Text="Azure OpenAI 请使用 whisper 部署以获取字幕时间戳。" TextWrapping="Wrap" Foreground="#718096" MinHeight="44" Margin="0,0,0,12"/><controls:ServiceSettingsEditor DataContext="{Binding Settings.Transcription}"/><Button Content="测试转写连接" Command="{Binding TestServiceCommand}" CommandParameter="Transcription" Margin="0,16,0,10"/><TextBlock Text="{Binding TranscriptionStatus}" TextWrapping="Wrap" FontSize="11"/></StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="文本翻译" Style="{StaticResource SectionTitle}"/><TextBlock Text="使用 Azure OpenAI 文本模型；请将服务类型设为 Azure OpenAI。" TextWrapping="Wrap" Foreground="#718096" MinHeight="44" Margin="0,0,0,12"/><controls:ServiceSettingsEditor DataContext="{Binding Settings.Translation}"/><Button Content="测试翻译连接" Command="{Binding TestServiceCommand}" CommandParameter="Translation" Margin="0,16,0,10"/><TextBlock Text="{Binding TranslationStatus}" TextWrapping="Wrap" FontSize="11"/></StackPanel></Border>
     <Border Grid.Column="4" Style="{StaticResource Card}"><StackPanel><TextBlock Text="文字转语音" Style="{StaticResource SectionTitle}"/><TextBlock Text="选择 Azure 音色，或在「我的声音」配置本地 GPT-SoVITS 本人音色。" TextWrapping="Wrap" Foreground="#718096" MinHeight="44" Margin="0,0,0,12"/><controls:ServiceSettingsEditor x:Name="SynthesisSettingsEditor" AllowLocalVoice="True" DataContext="{Binding Settings.Synthesis}"/><Button Content="测试配音连接" Command="{Binding TestServiceCommand}" CommandParameter="Synthesis" Margin="0,16,0,10"/><TextBlock Text="{Binding SynthesisStatus}" TextWrapping="Wrap" FontSize="11"/></StackPanel></Border>
    </Grid>
    <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="本地视频工具" Style="{StaticResource SectionTitle}"/><TextBlock Text="安装含 subtitles / libass 滤镜的 FFmpeg，并指定 ffmpeg.exe 与 ffprobe.exe。已加入 PATH 时可保留默认值。" TextWrapping="Wrap" Foreground="#718096" Margin="0,0,0,14"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FFmpeg 路径" Style="{StaticResource FieldLabel}"/><DockPanel><Button DockPanel.Dock="Right" Content="浏览" Command="{Binding BrowseToolCommand}" CommandParameter="ffmpeg" Margin="8,0,0,0"/><TextBox Text="{Binding Settings.Media.FfmpegPath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="FFprobe 路径" Style="{StaticResource FieldLabel}"/><DockPanel><Button DockPanel.Dock="Right" Content="浏览" Command="{Binding BrowseToolCommand}" CommandParameter="ffprobe" Margin="8,0,0,0"/><TextBox Text="{Binding Settings.Media.FfprobePath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel></StackPanel></Grid>
     <TextBlock Text="默认输出目录（留空则使用原视频所在目录）" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/><DockPanel><Button DockPanel.Dock="Right" Content="选择文件夹" Command="{Binding BrowseDirectoryCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding Settings.Media.OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/></DockPanel><Button Content="检查 FFmpeg / FFprobe" Command="{Binding CheckMediaCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
    </StackPanel></Border>
    <Border x:Name="OnlineSettingsCard" Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="在线视频下载" Style="{StaticResource SectionTitle}"/><TextBlock Text="配置视频下载工具与 YouTube 所需的 JavaScript 运行时。下载的素材保存在本机，可继续生成字幕和配音。" TextWrapping="Wrap" Foreground="#718096" Margin="0,0,0,14"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="yt-dlp 路径" Style="{StaticResource FieldLabel}"/><DockPanel><Button DockPanel.Dock="Right" Content="浏览" Command="{Binding BrowseToolCommand}" CommandParameter="downloader" Margin="8,0,0,0"/><TextBox Text="{Binding Settings.OnlineVideo.DownloaderPath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Deno 路径" Style="{StaticResource FieldLabel}"/><DockPanel><Button DockPanel.Dock="Right" Content="浏览" Command="{Binding BrowseToolCommand}" CommandParameter="deno" Margin="8,0,0,0"/><TextBox Text="{Binding Settings.OnlineVideo.JavaScriptRuntimePath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel></StackPanel>
     </Grid>
     <TextBlock Text="素材保存目录（留空使用本机应用数据目录）" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/><DockPanel><Button DockPanel.Dock="Right" Content="选择文件夹" Command="{Binding BrowseDownloadDirectoryCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding Settings.OnlineVideo.DownloadDirectory, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
     <TextBlock Text="代理地址（可选，例如 http://127.0.0.1:7890）" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/><TextBox Text="{Binding OnlineProxy, UpdateSourceTrigger=PropertyChanged}"/>
     <TextBlock Text="留空时尝试使用系统或环境代理。若浏览器能播放、软件却连接失败，请填写浏览器使用的代理地址和端口；浏览器扩展或 PAC 代理可能需要手动配置。" TextWrapping="Wrap" Foreground="#718096" FontSize="11" Margin="0,8,0,0"/>
     <TextBlock Text="Cookie 文件（可选，Netscape 格式）" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="选择文件" Command="{Binding BrowseCookiesCommand}" Margin="8,0,0,0"/><Button Content="清除" Command="{Binding ClearCookiesCommand}" Margin="8,0,0,0"/></StackPanel><TextBox Text="{Binding Settings.OnlineVideo.CookiesFilePath, Mode=OneWay}" IsReadOnly="True"/></DockPanel>
     <TextBlock Text="手动 Cookie 文件优先于已保存的验证会话，设置仅保存文件路径。使用转换页的新验证会话后，会清除这里的路径设置；原文件保留。" TextWrapping="Wrap" Foreground="#718096" FontSize="11" Margin="0,8,0,0"/>
     <TextBlock Text="YouTube 或 B 站要求登录／人机验证时，可在视频转换页点击「网页登录／验证」。项目只读取你打开的独立验证窗口，完成后由你点击保存该站会话；不会读取个人浏览器配置。网站仍可能要求额外验证，Cookie 不能保证下载成功。" TextWrapping="Wrap" Foreground="#55627A" FontSize="12" Margin="0,10,0,0"/>
     <Button Content="检查下载工具与运行时" Command="{Binding CheckOnlineToolsCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="语言与音色目录" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding CapabilityDescription}" TextWrapping="Wrap" Foreground="#718096"/><WrapPanel HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="刷新能力目录" Command="{Binding RefreshCapabilitiesCommand}" Margin="0,0,10,0"/><Button Content="保存设置并刷新" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}"/></WrapPanel></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="任务历史"><Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="刷新历史" Command="{Binding RefreshHistoryCommand}"/><StackPanel><TextBlock Text="继续之前的工作" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/><TextBlock Text="任务与校对结果保存在本机。请保留原视频，才能再次合成和导出。" Foreground="#718096"/></StackPanel></DockPanel>
    <DataGrid Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" IsReadOnly="True" SelectionMode="Single" RowHeight="56"><DataGrid.Columns><DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/><DataGridTextColumn Header="视频标题" ElementStyle="{StaticResource HistoryText}" Binding="{Binding Options.SourceTitle}" Width="*"/><DataGridTextColumn Header="原视频文件" ElementStyle="{StaticResource HistoryText}" Binding="{Binding Options.InputPath}" Width="2*"/><DataGridTextColumn Header="来源链接" ElementStyle="{StaticResource HistoryText}" Binding="{Binding Options.SourceUrl}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="片段" Binding="{Binding Segments.Count}" Width="55"/><DataGridTextColumn Header="输出位置" ElementStyle="{StaticResource HistoryText}" Binding="{Binding Options.OutputPath}" Width="2*"/></DataGrid.Columns></DataGrid>
    <Button Grid.Row="2" Content="恢复选中任务并继续校对" Command="{Binding RestoreCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,16,0,4"/>
   </Grid></TabItem>
   <TabItem Header="我的声音"><controls:LocalVoicePanel x:Name="MyVoicePanel"/></TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="White" BorderBrush="#DFE5EF" BorderThickness="0,1,0,0" Padding="26,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Stage}" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,20,0" MaxHeight="62" ToolTip="{Binding Status}"/><ProgressBar Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="7" VerticalAlignment="Center" Foreground="#3559D8" Background="#E9EDF5" BorderThickness="0"/><Button Grid.Column="3" Content="取消任务" Command="{Binding CancelCommand}" Margin="18,0,0,0"/></Grid></Border>
 </Grid>
</Window>
