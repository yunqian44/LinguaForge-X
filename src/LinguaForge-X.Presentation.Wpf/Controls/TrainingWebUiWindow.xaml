<Window x:Class="LinguaForge_X.Presentation.Wpf.Controls.TrainingWebUiWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="GPT-SoVITS · 本地训练工作台" Width="1280" Height="860" MinWidth="940" MinHeight="620"
 WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI, Segoe UI" Background="#F4F6FA"
 Loaded="Window_Loaded" Closed="Window_Closed">
 <DockPanel Margin="16">
  <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DFE5EF" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="刷新页面" Click="Reload_Click" Padding="16,8" Margin="16,0,0,0" VerticalAlignment="Center"/>
    <StackPanel>
     <TextBlock Text="GPT-SoVITS 本地训练工作台" FontSize="18" FontWeight="SemiBold" Foreground="#243149"/>
     <TextBlock Text="录音与校准请使用主窗口「我的声音」。关闭此窗口只隐藏界面；结束训练服务请使用主窗口的停止按钮。" TextWrapping="Wrap" Foreground="#55627A" Margin="0,7,0,0"/>
     <TextBlock Text="当前配置 v2 训练环境，请使用已校对的录音与文稿；页面中的可选 ASR／UVR 工具需另行准备模型和依赖。" TextWrapping="Wrap" Foreground="#718096" FontSize="12" Margin="0,6,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <TextBlock x:Name="BrowserStatus" DockPanel.Dock="Bottom" Text="正在加载本机训练界面…" TextWrapping="Wrap" Foreground="#385389" Margin="0,12,0,0"/>
  <Border Background="White" BorderBrush="#DFE5EF" BorderThickness="1"><wv2:WebView2 x:Name="Browser"/></Border>
 </DockPanel>
</Window>
